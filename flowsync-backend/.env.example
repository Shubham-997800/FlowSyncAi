# ---- Required ----
# MongoDB connection string (Atlas or any Mongo instance)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/flowsync
# JWT signing secret — min 32 chars, use a 64+ char random hex string
JWT_SECRET=replace-with-a-64-char-random-hex-string

# ---- CORS ----
# Allowed frontend origin (Vercel frontend URL in production)
CLIENT_URL=https://flowsyncai30.vercel.app
# Optional second allowed origin (e.g. local preview deployment)
# CLIENT_URL_2=https://another-frontend.vercel.app

# ---- AI (multi-provider with automatic failover; at least one key enables AI) ----
# Primary provider: Groq (fast, generous free tier)
GROQ_API_KEY=gsk_...
# Fallback providers (each key adds to the failover chain)
GEMINI_API_KEY=AIza...
CEREBRAS_API_KEY=csk-...
# Mistral supports multi-key rotation: add _2 to double capacity
MISTRAL_API_KEY=
# MISTRAL_API_KEY_2=
# OpenRouter gateway (free + paid tiers)
OPENROUTER_API_KEY=sk-or-...
XAI_API_KEY=
# Optional: force a single model first in the fallback chain
# AI_MODEL=llama-3.1-8b-instant

# ---- Web Push (VAPID keys from web-push) ----
VAPID_PUBLIC_KEY=BA...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:support@flowsync-ai.com

# ---- Email reminders (optional; app works without) ----# Resend API key — deadline reminders are emailed to users when set.
# RESEND_API_KEY=re_...
# Verified sender shown on reminder emails.
# EMAIL_FROM=FlowSync AI <reminders@flowsync-ai.com>

# ---- Error tracking (optional; app works without) ----
# Sentry DSN — server 5xx errors are reported when set.
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_TRACES_SAMPLE_RATE=0

# ---- Optional tuning ----
# How often the reminder sweep may run (ms). Default 30 min.
REMINDER_CHECK_INTERVAL=1800000
# Protects the /api/cron/reminders endpoint from public invocation. When set,
# the cron request must carry `Authorization: Bearer <CRON_SECRET>`.
# CRON_SECRET=replace-with-a-long-random-string
# Max AI calls per user per day. Default 300.
AI_DAILY_LIMIT=300
# Max chat sessions kept per user. Default 6.
MAX_CHAT_SESSIONS=6
# Rate-limit buckets (requests per window). Defaults 100/60s auth, 50/min AI, 300/min general, 5/min login, 30/min refresh.
# RATE_LIMIT_AUTH=100
# RATE_LIMIT_AI=50
# RATE_LIMIT_GENERAL=300
# RATE_LIMIT_LOGIN=5
# RATE_LIMIT_REFRESH=30
# Emit one JSON log line per request (structured logging).
# LOG_JSON=false

# ---- Server (local dev only; unused on Vercel) ----
PORT=5000
NODE_ENV=development
